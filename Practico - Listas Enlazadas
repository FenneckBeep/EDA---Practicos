//3) insOrden: dados un entero x y una lista l ordenada: inserta x en l ordenadamente.

//Iterativo:
void Insorden(Lista &L, int x){

    if(L == NULL || x < L->dato){
        Lista nuevo = new nodo;
        nuevo->dato = x;
        nuevo->sig = L;
        L = nuevo;
        return;
    }
   
    Lista aux = L;
    while(aux->sig != NULL && aux->sig->dato < x){
        aux = aux->sig;
    }

    Lista nuevo = new nodo;
    nuevo->dato = x;
    nuevo->sig = aux->sig;
    aux->sig = nuevo;
}

//Recursivo:

void Insorden(Lista &L, int x){

    if(L == NULL || x < L->dato){
        Lista nuevo = new nodo;
        nuevo->dato = x;
        nuevo->sig = L;
        L = nuevo;
        return;
    }

    Insorden(L->sig,x);
}

