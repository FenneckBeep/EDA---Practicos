//1) Ultimo: dada una lista no vacía, retorna su último elemento.

//Iterativo:
int Ultimo(Lista L){

    while(L->sig != NULL){
        L = L->sig;
    }

    return L->dato;
}

//Recursivo:
int Ultimo(Lista L){

   if(L->sig == NULL){
    return L->dato;
   }

   return Ultimo(L->sig);
    
}

