//2)Promedio: dada una lista no vacía, retorna el promedio de sus elementos.

//Iterativo:
float Promedio(Lista L){

    float total = 0;
    int cantidad = 0;

    while(L != NULL){
        total = total + L->dato;
        cantidad++;
        L = L->sig;
    }

    return total/cantidad;
}

//Recursivo: Dificilismo de hacer almenos que...
//Cambie la plantilla y la invoque con: "Promedio(L, 0, 0);"

float Promedio(Lista L, float total, int cantidad){
    
    if(L == NULL){
        return total/cantidad;
    }

    total = total + L->dato;
    cantidad++;
    return Promedio(L->sig, total, cantidad);
}

