// 2) SinPrimeros: dado un natural i y una lista l, retorna la lista resultado de eliminar los primeros i elementos de l. 

//Iterativo:

Lista SinPrimeros(Lista L, int x){
    
    while(L != NULL && x > 0){
        Lista borrar = L;
        L = L->sig;
        delete borrar;
        x--;
    }

    return L;
}

//Recursivo:

Lista SinPrimeros(Lista L, int x){

    if(L == NULL || x == 0){
        return L;
    }

    Lista borrar = L;
    L = L->sig;
    delete borrar;

    return SinPrimeros(L, x - 1);
}

