    while(L!= NULL && L->dato == x){ // Chequeo si el primer elemento es "X"
        Lista borrar = L;
        L = L->sig;
        delete borrar;
    }

    Lista aux = L;

    While(aux != NULL && aux->sig != NULL){

        if(aux->sig->dato == x){
            Lista borrar = aux->sig;
            aux->sig = borrar->sig;
            delete borrar;
        }

        aux = aux->sig;
    }
 
}

    

//Recursivo:

void RemoverTodos(Lista &L, int x){

    if(L == NULL){
