// 1) primeros: dado un natural i y una lista l, retorna la lista resultado de tomar los primeros i elementos de 
 

//Iterativo:
Lista primeros (Lista L, int x) {
    
    Lista res = NULL;
    Lista aux = NULL;

    while (L != NULL && x > 0) {
        if (res == NULL) {
            res = new nodo;
            aux = res;
        }
        else {
            aux->sig = new nodo;
            aux = aux->sig;
        }

        aux->info = L->info;
        aux->sig = NULL;
        L = L->sig;
        x--;
    }
    return res;
}

    
//Recursivo:

Lista Primeros(Lista L, int x){

    if(L == NULL || x == 0){
        return NULL;
    }

    Lista nuevo = new nodo;
    nuevo->dato = L->dato;
    nuevo->sig = Primeros(L->sig, x - 1);

    return nuevo;
}

