// 2) preOrden: que recibe un árbol b y retorna una lista con los elementos de b ordenados según la recorrida en pre orden de b.

void preOrden(AB A, Lista &L) {
    if (A == NULL)
        return;

    insFinal(L, A->dato);

    preOrden(A->izq, L);

    preOrden(A->der, L);
}

Lista preOrden(AB A) {
    Lista L = NULL;

    preOrden(A, L);

    return L;
}
//-------------------------------------------------
// 3) postOrden: que recibe un árbol b y retorna una lista con los elementos de b ordenados según la recorrida en post orden de b. 

void postOrden(AB A, Lista &L) {
    if (A == NULL)
        return;

    postOrden(A->izq, L);

    postOrden(A->der, L);

    insFinal(L, A->dato);
}

Lista postOrden(AB A) {
    Lista L = NULL;

    postOrden(A, L);

    return L;
}

