// ******************* EJERCICIO 6 - ARBOLES GENERALES  ********************

AG copiaParcial (AG a, unsigned k){
    if (a == NULL || k == 0)
        return NULL;
    AG copia = new nodoAG;
    copia->elem = a->elem;
    copia->pH = copiaParcial (a->pH, k-1);
    copia->sH = copiaParcial (a->sH, k);
    return copia;
}

// ******************* EJERCICIO 7 - ARBOLES GENERALES  ********************

bool esPrefijo (Lista L, AG a) {
    if (L == NULL)
        return true;
    if (a == NULL || L->elem != a->elem)
        return false;
    AG hijo = a->pH;
    while (hijo != NULL && !esPrefijo(L->sig, hijo))
        hijo = hijo->sH;
    return (hijo != NULL);
}


// ******************* EJERCICIO 8 - ARBOLES GENERALES  ********************
int mayorAmplitud(AG a) { 
    if (a == NULL)
        return 0;
    AG hijo = a->pH;
    int mis_hijos, amplitud, max_amplitud;
    mis_hijos = amplitud = max_amplitud = 0;
    while (hijo != NULL) {
        mis_hijos++;
        amplitud = mayorAmplitud(hijo);
        if (amplitud > max_amplitud)
            max_amplitud = amplitud;
        hijo = hijo->sH;
    }
    if (mis_hijos > max_amplitud)
        max_amplitud = mis_hijos;
    return max_amplitud;
}

