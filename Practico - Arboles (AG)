// Ejercicio 9
AG padre(AG a, int x) {
    if (a == NULL || a->elem == x)
        return NULL;
    AG hijo = a->pH;
    AG res = NULL;
    while (hijo != NULL && res == NULL) {
        if (hijo->elem == x)
            return a;
        else
            res = padre(hijo, x);
        hijo = hijo->sH;
    }
    return res;
}
