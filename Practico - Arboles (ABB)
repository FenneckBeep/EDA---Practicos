        return true;
    }

    if(A->dato < x){
        return perteneceABB(A->der, x);
    }else
        return perteneceABB(A->izq, x);

}

//------------------------------------------------------

// C) función maxABB: que recibe un ABB no vacío b 
// y devuelve el elemento de máximo valor en b.

// Precondicion: A no es vacio

//Solucion iterativa:
int maxABB(ABB A){

    while(A->der != NULL){
        A = A->der;
    }

    return A->dato;
}

//Solucion Recursiva:

void maxABB(ABB A){

    if(A->der == NULL){
        return A->dato;
    }

    maxABB(A->der);
}


//---------------------------------------------------------
// D) procedimiento removerMaxABB: que recibe un ABB no vacío b
// y elimina el elemento de máximo valor en b.

void RemoverMaxABB(ABB &A){

    if(A->der == NULL){
        ABB borrar = A;
        A = A->izq;
        delete borrar;
    }else{
        RemoverMaxABB(A->der);
    }

}
//---------------------------------------------------------

// E) procedimiento removerABB: que recibe un natural x y un ABB b y 
// elimina el elemento de valor x de b, manteniendo su cualidad de ABB. 

void removerABB(ABB &A, int x){

    if(A == NULL){
        return;
    }

    if(x < A->dato){
        removerABB(A->izq, x);
    }
    else{

        if(x > A->dato){
            removerABB(A->der, x);
        }
        else{

            // Caso 1: no tiene hijos
            if(A->izq == NULL && A->der == NULL){
                delete A;
                A = NULL;
            }

            // Caso 2: tiene solamente hijo derecho
            else{

                if(A->izq == NULL){
                    ABB aux = A;
                    A = A->der;
                    delete aux;
                }

                // Caso 2: tiene solamente hijo izquierdo
                else{

                    if(A->der == NULL){
                        ABB aux = A;
                        A = A->izq;
                        delete aux;
                    }

                    // Caso 3: tiene dos hijos
                    else{

                        ABB aux = A->izq;

                        while(aux->der != NULL){
                            aux = aux->der;
                        }

                        A->dato = aux->dato;

                        removerABB(A->izq, aux->dato);
                    }
                }
            }
        }
    }
}

//-------------------------------------------------------
//F) función k-esimo: que recibe un natural k y un ABB b y retorna el subárbol que tiene al k-ésimo menor 
//elemento de b como raíz. Si en b hay menos de k elementos o k es cero, la función debe retornar el 
//árbol vacío. Si k es 1, se refiere al menor elemento del árbol, si k es 2 al 2do elemento más pequeño 
//del árbol y así sucesivamente. La solución no puede visitar ningún nodo más de una vez. 
ABB kesimo(ABB A, int k){

    if(A == NULL || k <= 0){
        return NULL;
    }

    int cantidadIzq = 0;

    if(A->izq != NULL){
        cantidadIzq = A->izq->cant;
    }

    if(k <= cantidadIzq){
        return kesimo(A->izq, k);
    }

    if(k == cantidadIzq + 1){
        return A;
    }

    return kesimo(A->der, k - cantidadIzq - 1);
}
