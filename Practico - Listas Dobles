// 5) RemoverTodos: dados un entero x y una lista L, retorna el resultado de eliminar todas las ocurrencias de x de L. 

void removerTodos (ListaDoble & L, int x) {
    if (L == NULL)
        return;
    ListaDoble der = L, izq = L, borrar;
    // Borramos todo hacia la izquierda
    while (izq->ant != NULL) {
        if (izq->ant->info == x) {
            borrar = izq->ant;
            izq->ant = borrar->ant;
            if (izq->ant != NULL)
                izq->ant->sig = izq;
            delete borrar;
        }
        else 
            izq = izq->ant;
    }
    // Borramos todo hacia la derecha
    while (der->sig != NULL) {
        if (der->sig->info == x) {
            borrar = der->sig;
            der->sig = borrar->sig;
            if (der->sig != NULL)
                der->sig->ant = der;
            delete borrar;
        }
        else 
            der = der->sig;
    }
    // Si el nodo del comienzo tenía el elemento a borrar también lo borramos
    if (L->info == x) {
        if (L->sig == NULL && L->ant == NULL) {
            delete L;
            L = NULL;
            return;
        }
        if (L->sig == NULL) {
            borrar = L;
            L = L->ant;
            L->sig = NULL;
            delete borrar;
        }
        else {
            borrar = L;
            L->sig->ant = borrar->ant;
            if (L->ant != NULL)
                L->ant->sig = L->sig;
            L = L->sig;
            delete borrar;
        }
    }
}

